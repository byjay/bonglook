{
  "name": "outlook-ai-assistant",
  "version": "1.0.0",
  "description": "Outlook AI 어시스턴트 - 대화형 메일 검색 및 첨부파일 분석 (Cerebras)",
  "main": "src/main.js",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-builder install-app-deps",
    "dist": "electron-builder --win --x64",
    "dist:publish": "electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "com.you.outlook-ai-assistant",
    "productName": "Outlook AI 어시스턴트",
    "artifactName": "OutlookAI-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/renderer/assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Outlook AI 어시스턴트"
    },
    "publish": {
      "provider": "github",
      "owner": "YOUR_GITHUB_USERNAME",
      "repo": "outlook-ai-assistant"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.2.1",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.0.379",
    "pst-extractor": "^1.11.0",
    "xlsx": "^0.18.5"
  }
}
