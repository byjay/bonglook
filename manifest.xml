<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="MailApp">
  <Id>b0ng-l00k-a1-0ut-l00k-add1n-2024</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>BongLook AI</ProviderName>
  <DefaultLocale>ko-KR</DefaultLocale>
  <DisplayName DefaultValue="BongLook AI Mail Analyzer"/>
  <Description DefaultValue="AI 기반 메일 분석 도구 - 요약, 액션 아이템, 마감일 추출"/>
  <IconUrl DefaultValue="https://raw.githubusercontent.com/byjay/bonglook/main/public/icon.svg"/>
  <HighResolutionIconUrl DefaultValue="https://raw.githubusercontent.com/byjay/bonglook/main/public/icon.svg"/>
  <SupportUrl DefaultValue="https://github.com/byjay/bonglook"/>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://byjay.github.io/bonglook/"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>
</OfficeApp>
